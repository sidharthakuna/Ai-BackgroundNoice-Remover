spring.application.name=AI-Backgroound-Noice-Remover

spring.servlet.multipart.max-file-size=100MB
spring.servlet.multipart.max-request-size=100MB

spring.mvc.async.request-timeout=300000

# Comma-separated list of allowed origins, e.g. https://myapp.com,https://www.myapp.com
# Defaults to * (any origin) to preserve prior behavior.
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:*}

# Optional explicit paths to Python / FFmpeg executables
app.python.executable=${APP_PYTHON_EXECUTABLE:}
app.ffmpeg.path=${APP_FFMPEG_PATH:ffmpeg}

# Job retention in hours before eviction
app.jobs.retention-hours=${APP_JOBS_RETENTION_HOURS:2}
